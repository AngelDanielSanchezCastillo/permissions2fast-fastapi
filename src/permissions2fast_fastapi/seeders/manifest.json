{
  "version": "2.0",
  "strict": true,
  "on_failure": "rollback_all",
  "boot": {
    "dev": {
      "tables": {
        "categories": {
          "file": "boot/categories.json",
          "mode": "upsert"
        },
        "roles": {
          "file": "boot/roles.json",
          "mode": "upsert"
        },
        "permissions": {
          "file": "boot/permissions.json",
          "mode": "upsert",
          "field_mapping": {
            "category_id": "permission_category_id"
          }
        }
      },
      "dependencies": {
        "categories": [],
        "roles": [],
        "permissions": ["categories"]
      }
    },
    "prod": {
      "tables": {
        "categories": {
          "file": "boot/categories.json",
          "mode": "upsert"
        },
        "roles": {
          "file": "boot/roles.json",
          "mode": "upsert"
        },
        "permissions": {
          "file": "boot/permissions.json",
          "mode": "upsert",
          "field_mapping": {
            "category_id": "permission_category_id"
          }
        }
      },
      "dependencies": {
        "categories": [],
        "roles": [],
        "permissions": ["categories"]
      }
    }
  }
}
